# Set real values only in ignored local files or the host's secret environment.
# DATABASE_URL must target the dedicated preview database, never an existing production database.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
DEMO_EMAIL=demo@sounding.example
DEMO_PASSWORD=
SHARE_SECRET=

# Google OAuth; callback is BETTER_AUTH_URL + /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave both flags false until a configured sender has passed delivery verification.
AUTH_EMAIL_ENABLED=false
AUTH_EMAIL_DELIVERY_VERIFIED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Real recording processing (server-side only; live calls require a DB budget authorization)
OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
AI_PROCESSING_ENABLED=false
AI_APPROVED_RECORDING_ID=

# Optional ISO-639-1 hint for future approved transcription requests; omit for automatic detection.
TRANSCRIPTION_LANGUAGE=

# Public clip-only viewer origin; the main application stays protected.
CLIP_SHARE_ORIGIN=

# Gmail SMTP is optional; keep both email gates false until actual delivery is tested.
AUTH_EMAIL_PROVIDER=resend
SMTP_USER=
SMTP_PASS=
# Gmail uses smtp.gmail.com:465 with TLS. AUTH_EMAIL_FROM must equal SMTP_USER.
