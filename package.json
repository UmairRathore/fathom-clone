{
  "name": "fathom-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "predev": "node scripts/setup-demo.mjs",
    "test:smoke": "tsx scripts/smoke.ts",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs vercel.json",
    "format:check": "prettier --check src tests scripts docs README.md package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs vercel.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.22",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
