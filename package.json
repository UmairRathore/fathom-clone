{
  "name": "fathom-clone",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "predev": "node scripts/setup-demo.mjs",
    "test:smoke": "tsx scripts/smoke.ts",
    "format": "prettier --write src tests scripts docs README.md package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs vercel.json",
    "format:check": "prettier --check src tests scripts docs README.md package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs vercel.json",
    "dev:auth": "tsx scripts/local-auth.ts",
    "db:migrate": "tsx scripts/migrate-auth.ts",
    "test:auth:http": "tsx scripts/auth-smoke.ts",
    "test:neon": "tsx scripts/verify-neon.ts",
    "db:cleanup": "tsx scripts/cleanup-auth.ts",
    "check:private-output": "node scripts/check-private-output.mjs",
    "db:cleanup:recordings": "tsx scripts/cleanup-recordings.ts",
    "test:recordings:http": "tsx scripts/recording-security-smoke.ts",
    "prebuild": "node scripts/ensure-ffmpeg.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.12",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.62.1",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
