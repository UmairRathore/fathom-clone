{
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python .codex/capture.py prompt",
        "command_windows": "py -3 .codex/capture.py prompt"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python .codex/capture.py response",
        "command_windows": "py -3 .codex/capture.py response"
      }]
    }]
  }
}
